{
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/v2/catbox.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v2/catbox",
      "destination": "/api/v2/catbox.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
