# Isi lalu set di Vercel Project Settings -> Environment Variables (JANGAN commit file .env asli)

# Wajib diisi biar scraper/bot luar gak bisa manggil API ini tanpa izin.
# Bot WA/Telegram/web lo sendiri kirim header: X-Api-Key: <salah satu value ini>
API_KEYS=ganti-dengan-random-string-panjang,bisa-lebih-dari-satu-dipisah-koma

# Opsional: lock CORS ke domain tertentu (kalau dikosongkan, fallback ke "*"
# untuk browser request -- TAPI ini TIDAK menghalangi bot/curl, cuma browser).
ALLOWED_ORIGINS=https://xs0cietylabsz.biz.id

